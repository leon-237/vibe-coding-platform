# Copy to .env (never commit the real file). All values are server-side only.

SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./apprentissage.db
# Production example: postgresql+psycopg://user:pass@host:5432/apprentissage
PUBLIC_APP_URL=https://app.example.com
TOKEN_TTL_HOURS=720

# AI provider (Anthropic). Without this key the AI features return 503.
ANTHROPIC_API_KEY=
AI_MODEL_SIMPLE=claude-haiku-5-5
AI_MODEL_COMPLEX=claude-sonnet-5-5
# Prices in USD per million tokens: copy the official price list of the models you use.
AI_INPUT_USD_PER_MTOK=1.0
AI_OUTPUT_USD_PER_MTOK=5.0
FCFA_PER_USD=600
# Global daily stop on AI spend (all users).
DAILY_AI_SPEND_CAP_USD=50

# Payments (Flutterwave). Use the sandbox keys until the integration is validated.
FLW_SECRET_KEY=
FLW_WEBHOOK_HASH=
FLW_BASE_URL=https://api.flutterwave.com/v3

MAX_UPLOAD_MB=15
